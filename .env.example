# =============================================================
# Variables de entorno de OPTIMIA-HV (plantilla, SIN valores reales)
# =============================================================
# Copiar a .env y completar:  cp .env.example .env
# .env está en .gitignore: nunca se sube al repositorio.
# docker compose lo lee solo; en Python local, exportar las variables
# (o usar `set -a; source .env; set +a` en bash).
# =============================================================

# --- General ---
LOG_LEVEL=INFO
TZ=America/Argentina/Buenos_Aires
DASHBOARD_PORT=8501
# Corrida del ETL de biomasa al arrancar el servicio cron:
#   auto = sólo si todavía no hay datos (primer deploy) · si = siempre · no = nunca
ETL_AL_INICIAR=auto

# --- Avisos de fallas y alertas (opcionales) ---
# Ver docs/04_arquitectura/despliegue.md
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ON_SUCCESS=

# --- Pipeline solar: portal web de Growatt ---
# Usuario y clave de server.growatt.com y el ID numérico de la planta.
# Sin estas variables sólo fallan los pasos de Growatt; el clima y el
# pronóstico se descargan igual.
GROWATT_USER=
GROWATT_PASSWORD=
GROWATT_PLANT_ID=

# --- Pipeline solar: réplica en la base MySQL anterior (opcional) ---
# Si se define, cada tabla solar también se guarda en esa base, con los
# mismos nombres que usaban los scripts originales. Ejemplo (XAMPP local):
#   SOLAR_DB_URL=mysql+mysqlconnector://root:@localhost/datos
# Requiere: pip install -e ".[solar]"
SOLAR_DB_URL=
